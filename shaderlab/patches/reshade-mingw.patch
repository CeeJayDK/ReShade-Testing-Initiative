diff --git a/source/hook_manager.hpp b/source/hook_manager.hpp
index f818fc1..3b5f02c 100644
--- a/source/hook_manager.hpp
+++ b/source/hook_manager.hpp
@@ -72,6 +72,29 @@ namespace reshade::hooks
 		return reinterpret_cast<T>(call(reinterpret_cast<hook::address>(replacement), target));
 	}
 
+#ifdef __MINGW32__
+	// MinGW/Clang: MSVC implicitly converts function pointers to void*, standard C++ does not
+	template <typename T>
+	inline hook::address to_hook_address(T value) { return (hook::address)(value); }
+	template <typename F, typename G, std::enable_if_t<(std::is_function_v<std::remove_pointer_t<F>> || std::is_function_v<std::remove_pointer_t<G>>) && !std::is_same_v<F, hook::address *>, int> = 0>
+	inline bool install(const char *name, F target, G replacement, bool queue_enable = false)
+	{
+		return install(name, to_hook_address(target), to_hook_address(replacement), queue_enable);
+	}
+	template <typename G, std::enable_if_t<std::is_function_v<std::remove_pointer_t<G>>, int> = 0>
+	inline bool install(const char *name, hook::address vtable[], size_t vtable_index, G replacement)
+	{
+		return install(name, vtable, vtable_index, to_hook_address(replacement));
+	}
+	template <typename F, std::enable_if_t<std::is_function_v<std::remove_pointer_t<F>>, int> = 0>
+	inline bool is_hooked(F target) { return is_hooked(to_hook_address(target)); }
+	template <typename T, typename U, std::enable_if_t<std::is_function_v<std::remove_pointer_t<U>>, int> = 0>
+	inline T call(T replacement, U target)
+	{
+		return reinterpret_cast<T>(call(reinterpret_cast<hook::address>(replacement), to_hook_address(target)));
+	}
+#endif
+
